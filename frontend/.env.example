# 프론트엔드 환경 변수 예시
# 이 파일을 .env.local로 복사한 뒤 값을 바꿔서 사용합니다. (.env.local은 Git에서 제외됩니다)
#
# 주의: VITE_로 시작하는 변수는 빌드 결과(자바스크립트 파일)에 그대로 들어가 누구나 볼 수 있습니다.
# API 키·비밀번호 같은 비밀 값은 절대 넣지 않습니다.

# 백엔드 API 기본 주소 (로컬 Spring Boot 서버)
VITE_API_BASE_URL=http://localhost:8080

# Google 로그인 클라이언트 ID (공개용 값, FE-2 로그인 화면에서 사용)
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# true면 개발 서버(npm run dev)에서 MSW 목 응답을 사용합니다. 배포 빌드에서는 값과 관계없이 꺼집니다.
VITE_USE_MOCK=false
