# 백엔드 로컬 실행용 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 값을 바꿔 사용한다. 아래 값은 모두 가짜 예시다.
# .env는 Git에서 제외되며, 실제 비밀 값은 이 파일(.env.example)에 적지 않는다.
# 주입 방법은 README의 "로컬 실행 > 백엔드"를 참고한다.

# 실행 프로필: local(폐기 가능한 로컬 DB) / demo(보존할 개발·시연 DB)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 접속 정보 (docker-compose.yml과 애플리케이션이 함께 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shelved
DB_USERNAME=shelved
DB_PASSWORD=change-me-local-password

# Google 로그인: Google Cloud OAuth 클라이언트 ID (ID 토큰의 대상 검증용)
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# JWT 서명 키: 액세스·리프레시 토큰 서명용 비밀 문자열 (32바이트 이상 임의 값)
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes

# Claude API
# API 키
CLAUDE_API_KEY=sk-ant-example-not-a-real-key
# 본 응답용 모델 (NPC 대화·힌트·채점·사건 제작)
CLAUDE_MODEL=example-main-model-id
# 질문 분류용 작은 모델 (직접적인 정답 요구 차단 판정)
CLAUDE_FILTER_MODEL=example-filter-model-id
